# ── AI (xAI Grok) ──
XAI_KEY=xai-...
# 모델 변경 시 (기본 grok-4.20-0309-non-reasoning — 채팅용 고속·저비용)
# XAI_MODEL=grok-4.20-0309-non-reasoning
# /api/enrich 고서 지식 포함 상한 자수 (기본 120000, 0=무제한)
# SAJU_KB_MAX=120000

# ── 서버 ──
PORT=4000
BASE_URL=https://sajucat.co.kr

# ── 소셜 로그인 (현재 비활성 — 값을 넣으면 활성화됨) ──
